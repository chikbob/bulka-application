{
  "name": "bulka-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:cloud": "VITE_ROUTER_MODE=hash npm run build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@ionic/vue": "^8.7.16",
    "@ionic/vue-router": "^8.7.16",
    "ionicons": "^8.0.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.6.9",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.0.6"
  }
}
